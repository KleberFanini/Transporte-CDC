generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  admin
  visualizador
}

enum UsuarioStatus {
  ATIVO
  DESATIVADO
}

enum Plataforma {
  UBER
  NOVE_NOVE
}

enum corridaStatus{
  COMPLETA
  CANCELADA
  NAO_REALIZADA
  EM_ANDAMENTO
  DESCONHECIDO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  perfil    Perfil     @default(visualizador)
  status    UsuarioStatus  @default(ATIVO)
  
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  resetToken         String?   @db.VarChar(255)
  resetTokenExpiry   DateTime?
}

model Corrida {
  id                  String    @id @default(uuid())
  idCorridaPlataforma String?   @unique
  plataforma          Plataforma
  status              corridaStatus @default(DESCONHECIDO)
  
  // Datas e horários
  dataSolicitacao     DateTime? @db.Date
  horaSolicitacao     String?
  dataChegada         DateTime? @db.Date
  horaChegada         String?
  
  // Informações da viagem
  servico             String?
  programa            String?
  grupo               String?
  
  // Funcionário
  nome                String?
  sobrenome           String?
  nomeCompleto        String?
  email               String? 
  
  // Detalhamento da despesa
  detalhamentoDespesa String?
  
  // Valores e métricas
  valorTotal          Decimal?  @db.Decimal(10,2)
  distanciaMetros     Decimal?  @db.Decimal(10,2)
  duracaoMinutos      Int?
  
  // Endereços
  enderecoPartida     String?
  enderecoDestino     String?
  cidade              String?
  pais                String?
  
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  @@index([plataforma])
  @@index([status])
  @@index([dataSolicitacao])
  @@index([nomeCompleto])
}

model Translado {
  id                    String    @id @default(uuid())
  
  // Dados principais do lançamento
  tipo                  String?   
  lancamento            String?   
  responsavelCriacao    String?   
  fornecedor            String?   
  cnpjCpfFornecedor     String?   
  historico             String?   
  codigoContrato        String?   
  
  // Datas importantes
  dataCadastro          DateTime? @db.Date
  competencia           String?   
  dataEmissao           DateTime? @db.Date
  dataVencimento        DateTime? @db.Date
  statusAprovacao       String?   
  dataPagamento         DateTime? @db.Date
  
  // Valores financeiros
  valorBruto            Float?    
  valorLiquido          Float?    
  
  // Informações de pagamento
  projetoOrigem         String?   // Projeto principal
  valorPorProjeto       Float?    // Valor específico do projeto
  tipoPagamento         String?   
  numeroDocumento       String?   
  
  // Categorização
  observacoesRateios    String?   // Mudado para corresponder ao Excel
  observacoesGerais     String?   // Mudado para corresponder ao Excel
  
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  @@index([lancamento])
  @@index([fornecedor])
  @@index([competencia])
  @@index([dataVencimento])
}
